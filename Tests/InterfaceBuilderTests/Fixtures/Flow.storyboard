<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" initialViewController="WC0-00-001">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="22505"/>
    </dependencies>
    <scenes>
        <!--Window Controller-->
        <scene sceneID="SC0-00-001">
            <objects>
                <windowController id="WC0-00-001" customClass="FlowWindowController" customModule="InterfaceBuilderTests" customModuleProvider="target" sceneMemberID="viewController">
                    <window key="window" title="Flow" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="WIN-00-001">
                        <windowStyleMask key="styleMask" titled="YES" closable="YES" resizable="YES"/>
                        <rect key="contentRect" x="196" y="240" width="300" height="200"/>
                        <rect key="screenRect" x="0.0" y="0.0" width="1440" height="900"/>
                        <view key="contentView" id="WCV-00-001">
                            <rect key="frame" x="0.0" y="0.0" width="300" height="200"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </view>
                        <connections>
                            <outlet property="delegate" destination="WC0-00-001" id="WDL-00-001"/>
                        </connections>
                    </window>
                    <connections>
                        <segue destination="VC0-00-001" kind="relationship" relationship="window.shadowedContentViewController" id="REL-00-001"/>
                    </connections>
                </windowController>
                <customObject id="FR0-00-001" userLabel="First Responder" customClass="FirstResponder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--Main view controller: outlets, actions, a segue, a table, a container-->
        <scene sceneID="SC0-00-002">
            <objects>
                <viewController id="VC0-00-001" customClass="FlowViewController" customModule="InterfaceBuilderTests" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" id="VW0-00-001">
                        <rect key="frame" x="0.0" y="0.0" width="300" height="200"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <subviews>
                            <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-00-001">
                                <rect key="frame" x="18" y="164" width="100" height="16"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" title="Hello" id="LBC-00-001">
                                    <font key="font" metaFont="system"/>
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="BTN-00-001">
                                <rect key="frame" x="13" y="120" width="80" height="32"/>
                                <buttonCell key="cell" type="push" title="Next" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="BTC-00-001">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="system"/>
                                </buttonCell>
                                <connections>
                                    <segue destination="VC0-00-002" kind="modal" identifier="next" id="SEG-00-001"/>
                                </connections>
                            </button>
                            <scrollView autohidesScrollers="YES" horizontalLineScroll="24" horizontalPageScroll="10" verticalLineScroll="24" verticalPageScroll="10" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="SCR-00-001">
                                <rect key="frame" x="120" y="20" width="160" height="160"/>
                                <clipView key="contentView" id="CLP-00-001">
                                    <rect key="frame" x="1" y="1" width="158" height="158"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <subviews>
                                        <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" rowHeight="24" rowSizeStyle="automatic" viewBased="YES" id="TBL-00-001">
                                            <rect key="frame" x="0.0" y="0.0" width="158" height="158"/>
                                            <autoresizingMask key="autoresizingMask"/>
                                            <size key="intercellSpacing" width="17" height="0.0"/>
                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                            <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                            <tableColumns>
                                                <tableColumn identifier="NameColumn" width="126" minWidth="40" maxWidth="1000" id="COL-00-001">
                                                    <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Name">
                                                        <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                        <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                                    </tableHeaderCell>
                                                    <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                                    <prototypeCellViews>
                                                        <tableCellView identifier="NameCell" id="CEL-00-001" customClass="FlowCellView" customModule="InterfaceBuilderTests" customModuleProvider="target">
                                                            <rect key="frame" x="8" y="0.0" width="126" height="24"/>
                                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            <subviews>
                                                                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="CTF-00-001">
                                                                    <rect key="frame" x="0.0" y="4" width="126" height="16"/>
                                                                    <textFieldCell key="cell" lineBreakMode="truncatingTail" title="Cell" id="CTC-00-001">
                                                                        <font key="font" usesAppearanceFont="YES"/>
                                                                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                                    </textFieldCell>
                                                                </textField>
                                                            </subviews>
                                                            <constraints>
                                                                <constraint firstItem="CTF-00-001" firstAttribute="leading" secondItem="CEL-00-001" secondAttribute="leading" constant="2" id="CCS-00-001"/>
                                                                <constraint firstItem="CTF-00-001" firstAttribute="centerY" secondItem="CEL-00-001" secondAttribute="centerY" id="CCS-00-002"/>
                                                            </constraints>
                                                            <connections>
                                                                <outlet property="textField" destination="CTF-00-001" id="COT-00-001"/>
                                                                <outlet property="controller" destination="VC0-00-001" id="COT-00-002"/>
                                                            </connections>
                                                        </tableCellView>
                                                    </prototypeCellViews>
                                                </tableColumn>
                                            </tableColumns>
                                            <connections>
                                                <outlet property="dataSource" destination="VC0-00-001" id="TDS-00-001"/>
                                                <outlet property="delegate" destination="VC0-00-001" id="TDL-00-001"/>
                                            </connections>
                                        </tableView>
                                    </subviews>
                                </clipView>
                                <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="YES" id="HSC-00-001">
                                    <rect key="frame" x="1" y="143" width="158" height="16"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                </scroller>
                                <scroller key="verticalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="VSC-00-001">
                                    <rect key="frame" x="224" y="17" width="15" height="102"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                </scroller>
                            </scrollView>
                            <containerView translatesAutoresizingMaskIntoConstraints="NO" id="CNT-00-001">
                                <rect key="frame" x="20" y="20" width="80" height="80"/>
                                <connections>
                                    <segue destination="VC0-00-003" kind="embed" id="EMB-00-001"/>
                                </connections>
                            </containerView>
                        </subviews>
                        <constraints>
                            <constraint firstItem="LBL-00-001" firstAttribute="leading" secondItem="VW0-00-001" secondAttribute="leading" constant="20" id="K01-00-001"/>
                            <constraint firstItem="LBL-00-001" firstAttribute="top" secondItem="VW0-00-001" secondAttribute="top" constant="20" id="K02-00-001"/>
                            <constraint firstItem="BTN-00-001" firstAttribute="leading" secondItem="LBL-00-001" secondAttribute="leading" id="K03-00-001"/>
                            <constraint firstItem="BTN-00-001" firstAttribute="top" secondItem="LBL-00-001" secondAttribute="bottom" constant="12" id="K04-00-001"/>
                            <constraint firstAttribute="trailing" secondItem="SCR-00-001" secondAttribute="trailing" constant="20" id="K05-00-001"/>
                            <constraint firstItem="SCR-00-001" firstAttribute="top" secondItem="VW0-00-001" secondAttribute="top" constant="20" id="K06-00-001"/>
                            <constraint firstAttribute="bottom" secondItem="SCR-00-001" secondAttribute="bottom" constant="20" id="K07-00-001"/>
                            <constraint firstItem="SCR-00-001" firstAttribute="width" constant="160" id="K08-00-001"/>
                            <constraint firstItem="CNT-00-001" firstAttribute="leading" secondItem="VW0-00-001" secondAttribute="leading" constant="20" id="K09-00-001"/>
                            <constraint firstAttribute="bottom" secondItem="CNT-00-001" secondAttribute="bottom" constant="20" id="K10-00-001"/>
                            <constraint firstItem="CNT-00-001" firstAttribute="width" constant="80" id="K11-00-001"/>
                            <constraint firstItem="CNT-00-001" firstAttribute="height" constant="80" id="K12-00-001"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="label" destination="LBL-00-001" id="OUT-00-001"/>
                        <outlet property="table" destination="TBL-00-001" id="OUT-00-002"/>
                        <outlet property="helper" destination="HLP-00-001" id="OUT-00-003"/>
                        <segue destination="VC0-00-002" kind="sheet" identifier="sheet" id="SEG-00-002"/>
                    </connections>
                </viewController>
                <customObject id="HLP-00-001" customClass="FlowHelper" customModule="InterfaceBuilderTests" customModuleProvider="target">
                    <connections>
                        <outlet property="controller" destination="VC0-00-001" id="OUT-00-004"/>
                    </connections>
                </customObject>
                <customObject id="FR0-00-002" userLabel="First Responder" customClass="FirstResponder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--Second-->
        <scene sceneID="SC0-00-003">
            <objects>
                <viewController title="Second" storyboardIdentifier="Second" id="VC0-00-002" customClass="FlowViewController" customModule="InterfaceBuilderTests" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" id="VW0-00-002">
                        <rect key="frame" x="0.0" y="0.0" width="200" height="100"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </view>
                </viewController>
                <customObject id="FR0-00-003" userLabel="First Responder" customClass="FirstResponder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--Embedded-->
        <scene sceneID="SC0-00-004">
            <objects>
                <viewController title="Embedded" id="VC0-00-003" sceneMemberID="viewController">
                    <view key="view" id="VW0-00-003">
                        <rect key="frame" x="0.0" y="0.0" width="80" height="80"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </view>
                </viewController>
                <customObject id="FR0-00-004" userLabel="First Responder" customClass="FirstResponder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--Split view controller with two items-->
        <scene sceneID="SC0-00-005">
            <objects>
                <splitViewController storyboardIdentifier="Split" id="SPL-00-001" sceneMemberID="viewController">
                    <splitViewItems>
                        <splitViewItem canCollapse="YES" holdingPriority="260" behavior="sidebar" id="SPI-00-001"/>
                        <splitViewItem id="SPI-00-002"/>
                    </splitViewItems>
                    <splitView key="splitView" dividerStyle="thin" vertical="YES" id="SPV-00-001">
                        <rect key="frame" x="0.0" y="0.0" width="450" height="300"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </splitView>
                    <connections>
                        <segue destination="VC0-00-002" kind="relationship" relationship="splitItems" id="SPS-00-001"/>
                        <segue destination="VC0-00-003" kind="relationship" relationship="splitItems" id="SPS-00-002"/>
                    </connections>
                </splitViewController>
                <customObject id="FR0-00-005" userLabel="First Responder" customClass="FirstResponder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--Tab view controller-->
        <scene sceneID="SC0-00-006">
            <objects>
                <tabViewController selectedTabViewItemIndex="1" tabStyle="toolbar" storyboardIdentifier="Tabs" id="TAB-00-001" sceneMemberID="viewController">
                    <tabViewItems>
                        <tabViewItem label="General" identifier="general" image="gearshape" id="TBI-00-001"/>
                        <tabViewItem label="Advanced" identifier="advanced" id="TBI-00-002"/>
                    </tabViewItems>
                    <tabView key="tabView" type="noTabsNoBorder" id="TBV-00-001">
                        <rect key="frame" x="0.0" y="0.0" width="450" height="300"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <font key="font" metaFont="message"/>
                    </tabView>
                    <connections>
                        <segue destination="VC0-00-002" kind="relationship" relationship="tabItems" id="TBS-00-001"/>
                        <segue destination="VC0-00-003" kind="relationship" relationship="tabItems" id="TBS-00-002"/>
                    </connections>
                </tabViewController>
                <customObject id="FR0-00-006" userLabel="First Responder" customClass="FirstResponder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="gearshape" catalog="system" width="16" height="16"/>
    </resources>
</document>
