// A view whose event and drawing overrides live in an extension in another
// file (ViewFixtureOverrides.swiftfixture), as Mac apps often write them.
// The transpiler moves them into this class body; AppKit's own dispatch
// (hit testing, the responder, drawing) must then reach them.
import AppKit

final class Canvas: NSView {
    var log: [String] = []
    var strokes = 0
}

@MainActor func runViewFixture() -> [String] {
    let root = NSView(frame: NSRect(x: 0, y: 0, width: 200, height: 100))
    let canvas = Canvas(frame: NSRect(x: 50, y: 20, width: 100, height: 50))
    root.addSubview(canvas)
    var log: [String] = []
    let hit = root.hitTest(NSPoint(x: 60, y: 30))
    log.append("hit canvas \(hit === canvas)")
    let event = NSEvent.mouseEvent(with: .leftMouseDown, location: NSPoint(x: 60, y: 30), modifierFlags: [], timestamp: 0,
                                   windowNumber: 0, context: nil, eventNumber: 0, clickCount: 1, pressure: 1)!
    hit?.mouseDown(with: event)
    let responder: NSResponder = canvas
    responder.mouseDown(with: event)
    let view: NSView = canvas
    log.append("flipped \(view.isFlipped)")
    _ = canvas.recordDrawing()
    return log + canvas.log
}
